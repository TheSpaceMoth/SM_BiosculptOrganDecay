		<xpath>/Defs/ThingDef[defName="BiosculpterPod"]/comps/li[compClass="CompBiosculpterPod_RegenerationCycle"]/conditionsToPossiblyCure</xpath>
		<value>
			<li>OrganDecay</li>			
			<li MayRequire="Ludeon.RimWorld.Anomaly">OrganDecayCreepjoiner</li>
		</value>
	</Operation>
	
</Patch>
